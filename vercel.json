{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/sync-to-sheets",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/auto-sync",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/auto-sync-evening",
      "schedule": "30 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/google-health/auth",
      "destination": "/api/connect?provider=google&step=start"
    },
    {
      "source": "/api/google-health/callback",
      "destination": "/api/connect?provider=google&step=callback"
    },
    {
      "source": "/api/fatsecret/auth",
      "destination": "/api/connect?provider=fatsecret&step=start"
    },
    {
      "source": "/api/fatsecret/callback",
      "destination": "/api/connect?provider=fatsecret&step=callback"
    },
    {
      "source": "/api/google-health/register",
      "destination": "/api/integrations?view=register"
    },
    {
      "source": "/api/google-health/status",
      "destination": "/api/integrations"
    },
    {
      "source": "/api/google-health/sync",
      "destination": "/api/auto-sync"
    },
    {
      "source": "/api/google-health/sync-today",
      "destination": "/api/auto-sync"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/service-worker.js",
      "destination": "/service-worker.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}